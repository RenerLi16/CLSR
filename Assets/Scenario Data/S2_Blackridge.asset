  m_Name: S2_Blackridge
  m_EditorClassIdentifier: Assembly-CSharp::RescueScenarioData
  scenarioName: Blackridge Storm Rescue
  totalDays: 3
  totalLogisticsPoints: 10
  dailyDeploymentCap: 5
  maxExpeditionsPerDay: 2
  cumulativeCosts: 1
  briefing: "Every point a team carries is spent crossing the trail. A team keeps walking while it can still pay the next stretch, and stops where it runs out. The cache at Creek Shelter supplies points the day after a team passes it."
  branches:
  - branchName: West Fork
    rootNodeId: West Fork
    reportedSurvivors: 3
    note: Supply cache at Creek Shelter grants +5 next day. The lookout is farther along the other trail.
  - branchName: North Pass
    rootNodeId: North Pass
    reportedSurvivors: 5
    note: No cache. The summit is the longest approach in the pass.
  - branchName: Lake Fork
    rootNodeId: Lake Fork
    reportedSurvivors: 4
    note: "No cache. The two outer sites are equally deep, but the approaches may differ in cost."
  - branchName: South Spur
    rootNodeId: South Spur
    reportedSurvivors: 1
    note: No cache. The ridge route extends beyond Slide Zone.
  intelligenceReports:
  - afterDay: 1
    nodeId:
    newDifficulty: 0
    revisedEstimates:
    - rootNodeId: North Pass
      reportedSurvivors: 3
    - rootNodeId: South Spur
      reportedSurvivors: 8
    message: "Second-pass aerial sweep: the North Pass count included a packing crew that had already evacuated. The South Spur count missed a group holding near Ridge Cache."
