  scenarioName: Cedar Valley
  totalDays: 3
  totalLogisticsPoints: 9
  dailyDeploymentCap: 4
  maxExpeditionsPerDay: 2
  briefing: The aerial counts are rough estimates. Storage camps pay out the day after a team passes them.
  branches:
  - branchName: North Ridge
    rootNodeId: N1
    reportedSurvivors: 2
    note: "Storage +3 \xb7 access estimate 3\u20134"
  - branchName: West Woods
    rootNodeId: W1
    reportedSurvivors: 3
    note: "Storage +1 \xb7 access estimate 2\u20133"
  - branchName: River Road
    rootNodeId: R1
    reportedSurvivors: 5
    note: "No storage \xb7 access estimate 2\u20134"
  - branchName: Cliff Pass
    rootNodeId: C1
    reportedSurvivors: 1
    note: "No storage \xb7 access estimate 1\u20133"
  intelligenceReports:
  - afterDay: 1
    nodeId:
    newDifficulty: 0
    revisedEstimates:
    - rootNodeId: R1
      reportedSurvivors: 1
    - rootNodeId: C1
      reportedSurvivors: 4
    message: 'A field check found that the first aerial sweep counted the same River Road spur twice. A second sweep above Cliff Pass spotted a group the first sweep missed.'
  nodes:
  - nodeId: Camp
    parentNodeId: 
    depth: 0
    difficulty: 0
    survivorCount: 0
    logisticsReward: 0
