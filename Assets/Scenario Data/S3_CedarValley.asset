    parentNodeId: Camp
    depth: 1
    difficulty: 1
    survivorCount: 0
    logisticsReward: 0
    playerNote: "North Ridge entry. Check the branch board for the latest estimate."
    truthNote: "DIFF 1 \xb7 HERE 0 \xb7 North Ridge entry."
  - nodeId: N2
    parentNodeId: N1
    depth: 2
    difficulty: 3
    survivorCount: 1
    logisticsReward: 0
    playerNote: "Unexplored. It lies on the only route to the +3 storage camp."
    truthNote: "DIFF 3 \xb7 HERE 1. The trail splits toward N3 and N4."
  - nodeId: N3
    parentNodeId: N2
    depth: 3
    difficulty: 3
    survivorCount: 0
    logisticsReward: 3
    playerNote: "Storage camp location. The reward is known, but the final access difficulty is not."
    truthNote: "DIFF 3 \xb7 HERE 0 \xb7 Unlocks +3 logistics points starting the following day."
  - nodeId: N4
    parentNodeId: N2
    depth: 3
    difficulty: 3
    survivorCount: 1
    logisticsReward: 0
    playerNote: "Optional side path. No initial report distinguishes it from the storage camp route."
