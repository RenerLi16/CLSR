  m_Name: S3_CedarValley
  m_EditorClassIdentifier: Assembly-CSharp::RescueScenarioData
  scenarioName: Cedar Valley
  totalDays: 3
  totalLogisticsPoints: 10
  dailyDeploymentCap: 5
  maxExpeditionsPerDay: 2
  cumulativeCosts: 1
  briefing: "Every point a team carries is spent crossing the trail. A team keeps walking while it can still pay the next stretch, and stops where it runs out. The storage camp at N3 supplies points the day after a team passes it."
  branches:
  - branchName: North Ridge
    rootNodeId: N1
    reportedSurvivors: 4
    note: Supply cache at N3 grants +5 next day. Both far sites are roughly three points from camp.
  - branchName: West Woods
    rootNodeId: W1
    reportedSurvivors: 5
    note: No cache. Trail crews expect the two outer approaches to differ in cost.
  - branchName: River Road
    rootNodeId: R1
    reportedSurvivors: 6
    note: No cache. The river forks lead to a shorter spur and a longer approach.
  - branchName: Cliff Pass
    rootNodeId: C1
    reportedSurvivors: 1
    note: "No storage · about 3 points to the upper pass"
  intelligenceReports:
  - afterDay: 1
    nodeId:
    newDifficulty: 0
    revisedEstimates:
    - rootNodeId: R1
      reportedSurvivors: 4
    - rootNodeId: C1
      reportedSurvivors: 7
    message: "Second-pass aerial sweep: the River Road count included a supply column already recounted at camp. The Cliff Pass sweep missed a large group holding in the upper pass."
